<mxfile host="hermes">
  <diagram id="d1">
    <mxGraphModel dx="800" dy="600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="测试架构图" style="text;html=1;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a" value="盒子A" style="rounded=1;fillColor=#FFFFFF;strokeColor=#4A90D9;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b" value="盒子B" style="rounded=1;fillColor=#FFFFFF;strokeColor=#4A90D9;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="a" target="b">
