# =============================================================================
# 复制为 deploy/.env 后按需填写。无真实 Key 时保持 MOCK_EXTERNAL=true
# =============================================================================

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-long-random-string
MOCK_EXTERNAL=true

# Docker 数据绑定根目录（Windows 推荐 D:/dockers/zeroagent）
DOCKER_DATA_DIR=D:/dockers/zeroagent

# --- 应用连接（宿主机跑 uvicorn 时用 localhost）---
DATABASE_URL=mysql+aiomysql://zeroagent:zeropass@127.0.0.1:3306/zeroagent
REDIS_URL=redis://:redispass@127.0.0.1:6379/0
RABBITMQ_URL=amqp://zeroagent:rabbitpass@127.0.0.1:5672//
LITELLM_PROXY_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-litellm-dev

# --- Compose 服务账号 ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=zeroagent
MYSQL_USER=zeroagent
MYSQL_PASSWORD=zeropass
REDIS_PASSWORD=redispass
RABBITMQ_USER=zeroagent
RABBITMQ_PASSWORD=rabbitpass
NEO4J_USER=neo4j
NEO4J_PASSWORD=neopass

# --- 外置 OpenIM（本阶段不用，可留空）---
# OPENIM_API_URL=
# OPENIM_SECRET=

# --- 存储：开发推荐线上 OSS；无 AK 可改 minio 并 compose --profile minio ---
STORAGE_BACKEND=oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=zeroagent-dev
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# 公网 CDN/静态域名（上传后返回的 URL 前缀）
OSS_PUBLIC_BASE_URL=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- LLM（经 LiteLLM；国内 MiniMax 用 api.minimaxi.com）---
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com/v1
OPENAI_API_KEY=
AGNES_API_KEY=
LITELLM_MODEL=MiniMax-M3

# --- Embedding / Rerank 独立服务（compose --profile embed）---
EMBED_SERVICE_URL=http://127.0.0.1:8088
RERANK_SERVICE_URL=http://127.0.0.1:8088
EMBED_DIM=512
EMBED_BACKEND=st
EMBED_MODEL=BAAI/bge-small-zh-v1.5
DEVICE=cpu
# 国内镜像（可选）
# HF_ENDPOINT=https://hf-mirror.com
# 预下载后可写：EMBED_MODEL=/models/bge-small-zh-v1.5

# --- Milvus（compose --profile full）---
MILVUS_URI=http://127.0.0.1:19530
KB_MILVUS_COLLECTION=za_kb_chunks_v2

# --- 自托管 Langfuse（禁止 Cloud）---
LANGFUSE_HOST=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
